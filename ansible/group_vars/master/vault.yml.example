---
# ============================================================
# vault.yml.example
#
# Template pour les secrets du groupe [master], charge
# automatiquement par Ansible (group_vars/master/) sur tous les
# plays cibles sur le groupe master (donc aussi sur
# groups['master'][0], utilise par install-monitoring.yml).
#
# Usage :
#   1. Copier ce fichier :
#        cp ansible/group_vars/master/vault.yml.example \
#           ansible/group_vars/master/vault.yml
#   2. Remplacer la valeur ci-dessous par un vrai mot de passe.
#   3. Chiffrer le fichier :
#        ansible-vault encrypt ansible/group_vars/master/vault.yml
#   4. Lancer les playbooks avec --ask-vault-pass, ou
#      --vault-password-file=<chemin_vers_fichier_mdp> (fichier a
#      NE JAMAIS committer, deja couvert par .gitignore).
#
# vault.yml (une fois cree, chiffre ou non) est ignore par Git -
# seul ce .example, sans secret reel, est versionne.
# ============================================================
grafana_admin_password: "CHANGE_MOI_avant_ansible-vault_encrypt"
